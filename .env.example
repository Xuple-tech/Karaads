APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DEVELOPER_API_DOMAIN=api.localhost
DEVELOPER_API_UPSTREAM_BASE_URL=https://api.x.ai/v1
DEVELOPER_API_UPSTREAM_API_KEY=
DEVELOPER_API_DEFAULT_MAX_TOKENS=512
DEVELOPER_API_MIN_BALANCE_BUFFER_USD=0.000001
DEVELOPER_API_DEFAULT_TOPUP_AMOUNT_USD=25
DEVELOPER_API_MIN_TOPUP_AMOUNT_USD=5
DEVELOPER_API_MAX_TOPUP_AMOUNT_USD=5000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=kwati
REVERB_APP_KEY=kwati-local
REVERB_APP_SECRET=kwati-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
