/* eslint-disable react-hooks/exhaustive-deps */
import AppLogoIcon from "@/components/app-logo-icon";
import { MobileSegmentedControl } from "@/components/mobile-segmented-control";
import { MobileTabBar } from "@/components/mobile-tab-bar";
import { MobileTopBar } from "@/components/mobile-top-bar";
import {
  SidebarNavSkeleton,
  TrendCardSkeleton,
  UserProfileSkeleton,
} from "@/components/skeletons";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";
import { useAppearance } from "@/hooks/use-appearance";
import { useAuth } from "@/hooks/use-auth";
import axiosInstance from "@/lib/axios";
import { useMessageNotifications } from "@/hooks/use-message-notifications";
import { usePostLikeNotifications } from "@/hooks/use-post-like-notifications";
import { useRealtimeNotifications } from "@/hooks/use-realtime-notifications";
import { useUnreadMessagesCount } from "@/hooks/use-unread-messages-count";
import { useLiveNotificationCount } from "@/hooks/use-live-notification-count";
import { playNotificationSound } from "@/lib/notification-sound";
import { useMutation, useQuery } from "@tanstack/react-query";
import {
  useNavigate,
  useLocation,
  useSearchParams,
  Link as RouterLink,
} from "react-router-dom";
import {
  Bell,
  Home,
  LogOut,
  MessageCircleMore,
  Moon,
  MoreHorizontal,
  Search,
  Settings,
  Sun,
  User,
  Plus,
  X,
  WalletIcon,
} from "lucide-react";
import { AnimatePresence, motion, useReducedMotion } from "framer-motion";
import { useEffect, useState, useRef, useMemo } from "react";
import { Toaster } from "@/components/ui/sonner";
import { toast } from "sonner";
import { cn } from "@/lib/utils";
import { hashtagPath } from "@/lib/hashtag";
import { DownloadAppDialog } from "@/components/download-app-dialog";

const SWIPEABLE_ROUTES = ["/app", "/search"];

interface AuthUser {
  id: string;
  name: string;
  username: string;
  email: string;
  bio?: string;
  avatar?: string;
  followers_count: number;
  following_count: number;
  is_verified: boolean;
  created_at: string;
  is_following?: boolean;
}

interface Trend {
  tag: string;
  posts: string;
  category: string;
}

interface User {
  id: string;
  name: string;
  username: string;
  email: string;
  bio?: string;
  avatar?: string;
  followers_count: number;
  following_count: number;
  is_verified: boolean;
  created_at: string;
  is_following?: boolean;
}

type RealtimeLayoutNotification = {
  type?: "follow" | "like" | "comment" | "mention" | "reply";
  action?: string;
  content?: string;
  related_id?: string;
  user?: {
    id?: string;
    name?: string;
    username?: string;
  };
};

export default function AppLayout({
  children,
  hideMobileNav = false,
  hideTopNav = false,
  hideTopNavOnSmall = false,
}: {
  children: React.ReactNode;
  hideMobileNav?: boolean;
  hideTopNav?: boolean;
  hideTopNavOnSmall?: boolean;
}) {
  const navigate = useNavigate();
  const { pathname } = useLocation();
  const [searchParams] = useSearchParams();
  const [globalSearchInput, setGlobalSearchInput] = useState("");
  const prevPathRef = useRef(pathname);
  const touchStartX = useRef<number | null>(null);
  const touchEndX = useRef<number | null>(null);
  const { count: unreadMessagesCount, increment: incrementUnreadMessages } =
    useUnreadMessagesCount();
  const { appearance: theme, updateAppearance: toggleTheme } = useAppearance();
  const { auth, isLoading: authLoading } = useAuth();
  const prefersReducedMotion = useReducedMotion();

  const { appearance, updateAppearance } = useAppearance();
  const { data: trendsToShow = [], isLoading: trendingLoading } = useQuery({
    queryKey: ["layout", "trending"],
    queryFn: async (): Promise<Trend[]> => {
      const response = await axiosInstance.get("/api/trending");
      const payload = response.data?.data ?? response.data;

      if (Array.isArray(payload)) {
        return payload;
      }

      if (Array.isArray(payload?.data)) {
        return payload.data;
      }

      return [];
    },
    staleTime: 5 * 60 * 1000,
  });

  // Get current user from context
  const currentUser = auth?.user as AuthUser | undefined;
  const userLoading = authLoading;
  const viewingNotifications = pathname === "/notifications";
  const { notificationCount, clearNotificationCount } = useLiveNotificationCount({
    userId: currentUser?.id,
    enabled: Boolean(currentUser?.id),
    clearOnActive: viewingNotifications,
  });
  const { mutate: logout, isPending: isLoggingOut } = useMutation({
    mutationFn: async () => {
      await axiosInstance.post("/logout");
    },
    onSuccess: () => {
      window.location.href = "/";
    },
  });

  // Setup message notifications
  useMessageNotifications({
    userId: currentUser?.id || "",
    enabled: !!currentUser?.id,
    onMessageReceived: (message) => {
      void playNotificationSound();
      // Show in-app toast notification with click action
      toast.info(`New message from ${message.user?.name || "Someone"}`, {
        description: message.content.substring(0, 100),
        duration: 5000,
        // Add action button to navigate to messages
        action: {
          label: "View",
          onClick: () => {
            // console.log("🔗 Toast clicked - navigating to messages...");
            // Navigate using React Router
            navigate(`/messages/c/${message.conversation_id}`);
          },
        },
      });

      // Update unread count
      incrementUnreadMessages();
    },
    onError: () => {
      // console.error("Message notification error:", error);
    },
  });

  // Setup post like notifications
  usePostLikeNotifications({
    userId: currentUser?.id || "",
    postOwnerId: currentUser?.id || "", // Monitor likes on current user's posts
    enabled: !!currentUser?.id,
    onPostLiked: (data) => {
      void playNotificationSound();
      // Show in-app toast notification with click action
      const likerName = data.user?.name || "Someone";
      toast.info(`${likerName} liked your post`, {
        description: `Your post now has ${data.likes_count} ${data.likes_count === 1 ? "like" : "likes"}`,
        duration: 5000,
        // Add action button to navigate to the post
        action: {
          label: "View",
          onClick: () => {
            // console.log("🔗 Post like toast clicked - navigating to post...");
            // Navigate using React Router
            navigate(`/app/moments?post=${encodeURIComponent(data.post_id)}`);
          },
        },
      });
    },
    onError: () => {
      // console.error("Post like notification error:", error);
    },
  });

  useRealtimeNotifications({
    userId: currentUser?.id || "",
    onNotificationReceived: (notification: RealtimeLayoutNotification) => {
      if (!notification?.type || notification.type === "like") {
        return;
      }

      void playNotificationSound();

      if (viewingNotifications) {
        return;
      }

      const actorName = notification.user?.name || "Someone";
      const fallbackDescription = notification.content?.trim() || undefined;

      if (notification.type === "follow") {
        toast.info(`${actorName} followed you`, {
          description: fallbackDescription ?? "You have a new follower.",
          duration: 5000,
          action: {
            label: "View",
            onClick: () => {
              if (notification.user?.username) {
                navigate(`/@${notification.user.username}`);
                return;
              }

              navigate("/notifications");
            },
          },
        });
        return;
      }

      if (notification.type === "comment" || notification.type === "reply") {
        toast.info(`${actorName} ${notification.action || "interacted with your post"}`, {
          description: fallbackDescription,
          duration: 5000,
          action: {
            label: "View",
            onClick: () => {
              if (notification.related_id) {
                navigate(`/app/moments?post=${encodeURIComponent(notification.related_id)}`);
                return;
              }

              navigate("/notifications");
            },
          },
        });
        return;
      }

      if (notification.type === "mention") {
        toast.info(`${actorName} mentioned you`, {
          description: fallbackDescription,
          duration: 5000,
          action: {
            label: "View",
            onClick: () => {
              if (notification.related_id) {
                navigate(`/app/moments?post=${encodeURIComponent(notification.related_id)}`);
                return;
              }

              navigate("/notifications");
            },
          },
        });
        return;
      }

      toast.info(notification.action || "You have a new notification", {
        description: fallbackDescription,
        duration: 5000,
      });
    },
    onError: () => {
      // console.error("Realtime notification error:", error);
    },
  });

  const direction = (() => {
    const prevIndex = SWIPEABLE_ROUTES.indexOf(prevPathRef.current);
    const currentIndex = SWIPEABLE_ROUTES.indexOf(pathname);
    if (prevIndex !== -1 && currentIndex !== -1) {
      return currentIndex > prevIndex ? 1 : -1;
    }
    return 0;
  })();

  useEffect(() => {
    prevPathRef.current = pathname;
  }, [pathname]);

  useEffect(() => {
    if (pathname === "/search") {
      setGlobalSearchInput(searchParams.get("q") ?? "");
      return;
    }
    setGlobalSearchInput("");
  }, [pathname, searchParams]);

  const handleTouchStart = (e: React.TouchEvent) => {
    const target = e.target as HTMLElement | null;
    const isInteractiveTarget = Boolean(
      target?.closest(
        "a,button,input,textarea,select,[role='button'],[role='tab'],[data-no-swipe='true']",
      ),
    );

    if (isInteractiveTarget) {
      touchStartX.current = null;
      touchEndX.current = null;
      return;
    }

    touchStartX.current = e.targetTouches[0].clientX;
    touchEndX.current = null;
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    touchEndX.current = e.targetTouches[0].clientX;
  };

  const handleTouchEnd = () => {
    if (!touchStartX.current || !touchEndX.current) return;

    const distance = touchStartX.current - touchEndX.current;
    const isSignificantSwipe = Math.abs(distance) > 50;

    if (isSignificantSwipe) {
      const currentIndex = SWIPEABLE_ROUTES.indexOf(pathname);
      if (currentIndex !== -1) {
        if (distance > 0 && currentIndex < SWIPEABLE_ROUTES.length - 1) {
          // Swipe left -> Next tab
          navigate(SWIPEABLE_ROUTES[currentIndex + 1]);
        } else if (distance < 0 && currentIndex > 0) {
          // Swipe right -> Previous tab
          navigate(SWIPEABLE_ROUTES[currentIndex - 1]);
        }
      }
    }

    touchStartX.current = null;
    touchEndX.current = null;
  };

  const activeTab = pathname;
  const submitGlobalSearch = () => {
    const trimmed = globalSearchInput.trim();
    if (!trimmed) {
      navigate("/search");
      return;
    }

    if (trimmed.startsWith("#")) {
      const path = hashtagPath(trimmed);
      if (path) {
        navigate(path);
        return;
      }
    }

    navigate(`/search?q=${encodeURIComponent(trimmed)}`);
  };

  const desktopNav = [
    { name: "Home", href: "/app", icon: Home },
    { name: "Search", href: "/search", icon: Search },
    { name: "Earn", href: "/earn", icon: WalletIcon },
    {
      name: "Messages",
      href: "/messages",
      icon: MessageCircleMore,
      badge: unreadMessagesCount > 0 ? unreadMessagesCount : undefined,
    },
    {
      name: "Notifications",
      href: "/notifications",
      icon: Bell,
      badge: notificationCount > 0 ? notificationCount : undefined,
    },
    {
      name: "Profile",
      href: currentUser?.username ? `/@${currentUser.username}` : "/profile",
      icon: User,
    },
  ];

  const isFeedPage =
    pathname === "/app" ||
    pathname === "/search" ||
    pathname === "/app/moments";
  const feedMode =
    searchParams.get("feed") === "following" ? "following" : "for-you";
  const hasOwnHeader =
    pathname === "/app" ||
    pathname === "/search" ||
    pathname === "/notifications" ||
    pathname === "/app/moments" ||
    pathname === "/live";
  const hideTrendingSidebar =
    pathname === "/messages" ||
    pathname.startsWith("/messages/") ||
    pathname === "/app/moments" ||
    pathname.startsWith("/live");

  // Desktop Sidebar Navigation
  const desktopSidebar = useMemo(
    () => (
      <div className="fixed top-0 left-0 hidden h-screen flex-col border-r border-border bg-background text-foreground xl:flex xl:w-[275px]">
        <div className="flex flex-1 flex-col px-2 py-4">
          {/* Logo */}
          <div className="mb-4 flex items-center justify-start px-3">
            <AppLogoIcon className="bg-body size-16 rounded-full p-2" />
          </div>

          {/* Search Bar - Desktop */}
          <div className="mb-4 px-3">
            <div className="relative">
              <Search className="absolute top-1/2 left-3 h-5 w-5 -translate-y-1/2 transform text-muted-foreground" />
              <input
                type="text"
                placeholder="Search posts or people"
                value={globalSearchInput}
                onFocus={() => {
                  if (pathname !== "/search") navigate("/search");
                }}
                onChange={(e) => setGlobalSearchInput(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter") {
                    e.preventDefault();
                    submitGlobalSearch();
                  }
                }}
                className="w-full rounded-full border border-border bg-card py-2 pr-4 pl-12 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring/30"
              />
              {globalSearchInput ? (
                <button
                  type="button"
                  aria-label="Clear search"
                  onClick={() => {
                    setGlobalSearchInput("");
                    if (pathname === "/search") {
                      navigate("/search");
                    }
                  }}
                  className="absolute top-1/2 right-10 flex h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full text-muted-foreground hover:bg-accent hover:text-foreground"
                >
                  <X className="h-3.5 w-3.5" />
                </button>
              ) : null}
              <button
                type="button"
                aria-label="Submit search"
                onClick={submitGlobalSearch}
                className="absolute top-1/2 right-2 flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full bg-accent text-foreground/80 hover:bg-accent/80 hover:text-foreground"
              >
                <Search className="h-3.5 w-3.5" />
              </button>
            </div>
          </div>

          {/* Navigation Links */}
          {userLoading ? (
            <SidebarNavSkeleton />
          ) : (
            <nav className="flex-1 space-y-1">
              {desktopNav.map((item) => {
                // Skip profile if guest
                if (item.name === "Profile" && !currentUser) return null;

                const Icon = item.icon;
                const isActive =
                  item.href === "/messages"
                    ? pathname === "/messages" ||
                      pathname.startsWith("/messages/")
                    : item.href === "/notifications"
                      ? pathname === "/notifications"
                      : activeTab === item.href;
                return (
                  <RouterLink
                    key={item.name}
                    to={item.href}
                    className={`group relative flex items-center gap-4 rounded-full px-4 py-3 transition-colors ${
                      isActive ? "font-bold" : "hover:bg-accent"
                    }`}
                  >
                    <Icon
                      className={`h-6 w-6 ${isActive ? "stroke-[2.5]" : ""}`}
                    />
                    <span className="text-xl">{item.name}</span>
                    {item.badge && (
                      <Badge
                        variant="destructive"
                        className="absolute top-2 left-7 flex h-5 w-5 items-center justify-center p-0 text-xs"
                      >
                        {item.badge}
                      </Badge>
                    )}
                  </RouterLink>
                );
              })}

              {/* More Button */}
              <DropdownMenu>
                <DropdownMenuTrigger asChild>
                  <Button
                    variant="ghost"
                    className="flex w-full items-center justify-start gap-4 rounded-full px-4 py-3 hover:bg-accent"
                  >
                    <MoreHorizontal className="h-6 w-6" />
                    <span className="text-xl">More</span>
                  </Button>
                </DropdownMenuTrigger>
                <DropdownMenuContent align="start" className="w-56">
                  <DropdownMenuItem>
                    <Settings className="mr-2 h-4 w-4" />
                    Settings
                  </DropdownMenuItem>
                  <DropdownMenuItem
                    onClick={() =>
                      toggleTheme(theme === "dark" ? "light" : "dark")
                    }
                  >
                    {theme === "dark" ? (
                      <Sun className="mr-2 h-4 w-4" />
                    ) : (
                      <Moon className="mr-2 h-4 w-4" />
                    )}
                    {theme === "dark" ? "Light Mode" : "Dark Mode"}
                  </DropdownMenuItem>
                  <DropdownMenuSeparator />
                  <DropdownMenuItem>
                    <LogOut className="mr-2 h-4 w-4" />
                    Log out
                  </DropdownMenuItem>
                </DropdownMenuContent>
              </DropdownMenu>
            </nav>
          )}

          {/* Post Button */}
          <Button
            onClick={() => navigate("/post/create")}
            className="mb-4 w-full rounded-full py-6 text-lg font-bold"
          >
            Post
          </Button>

          {/* User Profile or Login */}
          {userLoading ? (
            <UserProfileSkeleton />
          ) : currentUser ? (
            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <Button
                  variant="ghost"
                  className="w-full rounded-full p-3 hover:bg-accent"
                >
                  <div className="flex w-full items-center gap-3">
                    <Avatar className="h-10 w-10">
                      <AvatarImage src={currentUser?.avatar} />
                      <AvatarFallback>
                        {currentUser?.username?.[0]?.toUpperCase()}
                      </AvatarFallback>
                    </Avatar>
                    <div className="flex-1 overflow-hidden text-left">
                      <p className="truncate text-sm font-semibold">
                        {currentUser?.name}
                      </p>
                      <p className="truncate text-xs text-muted-foreground">
                        @{currentUser?.username}
                      </p>
                    </div>
                    <MoreHorizontal className="h-4 w-4 flex-shrink-0" />
                  </div>
                </Button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end" className="w-56">
                <DropdownMenuItem
                  onClick={() =>
                    navigate(
                      currentUser?.username
                        ? `/@${currentUser.username}`
                        : "/profile",
                    )
                  }
                >
                  <User className="mr-2 h-4 w-4" />
                  Profile
                </DropdownMenuItem>
                <DropdownMenuItem onClick={() => navigate("/settings/profile")}>
                  <Settings className="mr-2 h-4 w-4" />
                  Settings
                </DropdownMenuItem>
                <DropdownMenuSeparator />
                <DropdownMenuItem
                  disabled={isLoggingOut}
                  onClick={() => logout()}
                >
                  <LogOut className="mr-2 h-4 w-4" />
                  {isLoggingOut
                    ? "Logging out..."
                    : `Log out @${currentUser?.username}`}
                </DropdownMenuItem>
              </DropdownMenuContent>
            </DropdownMenu>
          ) : (
            <div className="px-3 pb-4">
              <Button
                onClick={() => navigate("/login")}
                className="w-full rounded-full font-bold"
              >
                Log in
              </Button>
            </div>
          )}
        </div>
      </div>
    ),
    [
      activeTab,
      currentUser,
      desktopNav,
      globalSearchInput,
      isLoggingOut,
      pathname,
      theme,
      userLoading,
      navigate,
      logout,
      submitGlobalSearch,
      setGlobalSearchInput,
      toggleTheme,
    ],
  );

  // Mobile/Tablet Top Navigation
  const topNav = useMemo(
    () => (
      <MobileTopBar
        title={
          pathname.startsWith("/messages")
            ? "Messages"
            : pathname === "/notifications"
              ? "Notifications"
              : pathname.startsWith("/@") || pathname === "/profile"
                ? "Profile"
                : "KaraAds"
        }
        leftAction={{
          icon: Bell,
          label: "Notifications",
          onClick: () => {
            clearNotificationCount();
            navigate("/notifications");
          },
          badgeCount: notificationCount > 0 ? 1 : undefined,
        }}
        rightActions={[
          {
            icon: MessageCircleMore,
            label: "Messages",
            onClick: () => navigate("/messages"),
            badgeCount:
              unreadMessagesCount > 0 ? unreadMessagesCount : undefined,
          },
        ]}
        centerSlot={
          isFeedPage ? (
            <MobileSegmentedControl
              value={feedMode}
              options={[
                { id: "for-you", label: "For You" },
                { id: "following", label: "Followed" },
              ]}
              onChange={(next) => {
                if (!isFeedPage) return;
                navigate(`${pathname}?feed=${next}`);
              }}
              className="mx-auto"
            />
          ) : undefined
        }
      />
    ),
    [clearNotificationCount, feedMode, isFeedPage, navigate, notificationCount, pathname, unreadMessagesCount],
  );

  // Mobile Bottom Navigation
  const mobileBottomNav = useMemo(
    () => (
      <MobileTabBar
        activeHref={activeTab}
        items={[
          { id: "home", label: "Home", href: "/app", icon: Home },
          { id: "search", label: "Search", href: "/search", icon: Search },
          {
            id: "brand",
            label: "KaraAds",
            href: "/earn",
            isCenterAction: true,
            renderIcon: () => (
              <AppLogoIcon
                alt="KaraAds"
                className="h-7 w-7 rounded-xl object-contain"
              />
            ),
          },
          {
            id: "messages",
            label: "Messages",
            href: "/messages",
            icon: MessageCircleMore,
            badgeCount: unreadMessagesCount > 0 ? unreadMessagesCount : undefined,
          },
          {
            id: "profile",
            label: "Profile",
            href: currentUser?.username ? `/@${currentUser.username}` : "/profile",
            icon: User,
          },
          {
            id: "create",
            label: "Create",
            href: "/post/create",
            icon: Plus,
            isFloatingAction: true,
          },
        ]}
        isActive={(item) => {
          if (item.id === "profile") {
            return pathname.startsWith("/@") || activeTab === item.href;
          }
          if (item.id === "messages") {
            return (
              pathname === "/messages" || pathname.startsWith("/messages/")
            );
          }
          if (item.id === "brand") {
            return pathname === "/app" || pathname === "/app/moments";
          }
          return activeTab === item.href;
        }}
      />
    ),
    [activeTab, currentUser?.username, pathname, unreadMessagesCount],
  );

  // Right Sidebar
  const rightSidebar = useMemo(
    () => (
      <div className="fixed top-0 right-0 hidden h-screen overflow-y-auto border-l border-border bg-background text-foreground lg:block lg:w-[350px] xl:w-[380px]">
        <div className="space-y-4 p-4 pt-4">
          {/* Trending Section */}
          <div className="overflow-hidden rounded-2xl border border-border bg-card">
            <div className="px-4 py-3">
              <h2 className="text-lg font-semibold">Trends for you</h2>
            </div>

            {trendingLoading ? (
              <div className="space-y-2 px-4 py-3">
                {Array.from({ length: 5 }).map((_, i) => (
                  <TrendCardSkeleton key={i} />
                ))}
              </div>
            ) : (
              <>
                {trendsToShow.slice(0, 5).map((trend, index) => (
                  <button
                    type="button"
                    key={index}
                    onClick={() => {
                      const path = hashtagPath(trend.tag);
                      if (path) {
                        navigate(path);
                      }
                    }}
                    className="cursor-pointer px-4 py-3 transition-colors hover:bg-accent/60"
                  >
                    <div className="flex items-start justify-between">
                      <div className="flex-1">
                        <p className="text-xs text-muted-foreground">
                          {trend.category} · Trending
                        </p>
                        <p className="font-bold">{trend.tag}</p>
                        <p className="text-xs text-muted-foreground">
                          {trend.posts} posts
                        </p>
                      </div>
                      <span className="inline-flex h-8 w-8 items-center justify-center text-muted-foreground">
                        <MoreHorizontal className="h-4 w-4" />
                      </span>
                    </div>
                  </button>
                ))}
              </>
            )}

            <div className="cursor-pointer px-4 py-3 text-muted-foreground hover:bg-accent/60 hover:text-foreground">
              Show more
            </div>
          </div>

          {/* Footer */}
          <div className="flex flex-wrap gap-2 px-4 py-3 text-xs text-muted-foreground">
            <a href="/terms" className="hover:underline">
              Terms of Service
            </a>
            <span>·</span>
            <a href="/privacy" className="hover:underline">
              Privacy Policy
            </a>
            <span>·</span>
            <a href="/csae-policy" className="hover:underline">
              Child Safety
            </a>
            <span>·</span>
            <a href="/privacy" className="hover:underline">
              Cookie Policy
            </a>
            <span>·</span>
            <a href="/terms" className="hover:underline">
              Accessibility
            </a>
            <span>·</span>
            <span>© {new Date().getFullYear()} KaraAds, Inc.</span>
          </div>
        </div>
      </div>
    ),
    [navigate, trendingLoading, trendsToShow],
  );

  return (
    <div className="karads-mobile min-h-screen bg-background text-foreground">
      {/* Desktop Sidebar */}
      {desktopSidebar}

      {/* Mobile Top Nav */}
      {!hideTopNav && !hasOwnHeader &&
        (hideTopNavOnSmall ? <div className="hidden sm:block">{topNav}</div> : topNav)}

      {/* Main Content Area */}
      <div
        className={cn(
          "xl:ml-[275px]",
          !hideTrendingSidebar && "lg:mr-[350px] xl:mr-[380px]",
        )}
        onTouchStart={handleTouchStart}
        onTouchMove={handleTouchMove}
        onTouchEnd={handleTouchEnd}
      >
        <main
          className={cn(
            "min-h-screen overflow-x-hidden border-x border-border xl:pb-0",
            hideMobileNav
              ? ""
              : "pb-[calc(5.5rem+env(safe-area-inset-bottom))]",
          )}
        >
           <DownloadAppDialog />
          <AnimatePresence mode="wait" initial={false} custom={direction}>
            <motion.div
              key={pathname}
              custom={direction}
              initial={{
                x:
                  prefersReducedMotion || pathname.startsWith("/messages/")
                    ? 0
                    : direction > 0
                      ? "100%"
                      : direction < 0
                        ? "-100%"
                        : 0,
                opacity: prefersReducedMotion ? 1 : 0,
              }}
              animate={{ x: 0, opacity: 1 }}
              exit={{
                x:
                  prefersReducedMotion || pathname.startsWith("/messages/")
                    ? 0
                    : direction > 0
                      ? "-100%"
                      : direction < 0
                        ? "100%"
                        : 0,
                opacity: prefersReducedMotion ? 1 : 0,
              }}
              transition={{
                x: prefersReducedMotion
                  ? { duration: 0 }
                  : { type: "spring", stiffness: 300, damping: 30 },
                opacity: { duration: prefersReducedMotion ? 0 : 0.2 },
              }}
              className="w-full"
            >
              {children}
            </motion.div>
          </AnimatePresence>
        </main>
      </div>

      {/* Right Sidebar */}
      {!hideTrendingSidebar && rightSidebar}

      {/* Mobile Bottom Navigation */}
      {!hideMobileNav && mobileBottomNav}
      <Toaster />
    </div>
  );
}

