{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_V12_BASE_URL": "https://karaads.com/api/open-labs/oyibo/v1.2",
        "EXPO_PUBLIC_API_V11_BASE_URL": "https://karaads.com/api/open-labs/oyibo/v1.1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_V12_BASE_URL": "https://karaads.com/api/open-labs/oyibo/v1.2",
        "EXPO_PUBLIC_API_V11_BASE_URL": "https://karaads.com/api/open-labs/oyibo/v1.1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_V12_BASE_URL": "https://karaads.com/api/open-labs/oyibo/v1.2",
        "EXPO_PUBLIC_API_V11_BASE_URL": "https://karaads.com/api/open-labs/oyibo/v1.1"
      }
    }
  }
}